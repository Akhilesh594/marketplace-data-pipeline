# Template only. Copy values into your terminal; .env files are not auto-loaded.
GCP_PROJECT_ID=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repository/service-account.json
DBT_PROFILES_DIR=/absolute/path/to/retail-platform/config
AIRBYTE_URL=http://localhost:8000
AIRBYTE_CONNECTION_ID=your-airbyte-connection-id
AIRBYTE_CLIENT_ID=your-airbyte-application-client-id
AIRBYTE_CLIENT_SECRET=your-airbyte-application-client-secret
AIRBYTE_WAIT_SECONDS=3600
